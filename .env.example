# .env.example
# Copie para .env.local e preencha com os valores do ambiente (local/staging).
# NUNCA commitar .env.local ou qualquer arquivo .env real (PROJECT_RULES.md §13.2).

# --- Client (expostas ao browser, prefixo obrigatório NEXT_PUBLIC_) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ENV=local

# --- Server-only (nunca expostas ao client — PROJECT_RULES.md §10.5) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
